generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  phone                  String                  @unique
  email                  String?                 @unique
  passwordHash           String                  @map("password_hash")
  role                   Role                    @default(PHARMACIST)
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at")
  auditLogs              AuditLog[]
  commissionTransactions CommissionTransaction[]
  expenses               Expense[]
  inventoryTransactions  InventoryTransaction[]
  notifications          Notification[]
  payments               Payment[]
  payrolls               Payroll[]
  purchases              Purchase[]
  saleReturns            SaleReturn[]
  sales                  Sale[]

  @@map("users")
}

model CustomerTier {
  id                 String     @id @default(uuid())
  name               String     @unique
  discountPercentage Decimal    @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  minimumPoints      Int        @default(0) @map("minimum_points")
  description        String?
  isActive           Boolean    @default(true) @map("is_active")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")
  customers          Customer[]

  @@map("customer_tiers")
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  phone              String              @unique
  email              String?
  address            String?
  notes              String?
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  gender             Gender?
  tierId             String?             @map("tier_id")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")
  customerInsurances CustomerInsurance[]
  tier               CustomerTier?       @relation(fields: [tierId], references: [id])
  loyaltyAccount     LoyaltyAccount?
  saleReturns        SaleReturn[]
  sales              Sale[]
  whatsAppMessages   WhatsAppMessage[]

  @@index([phone])
  @@index([name])
  @@index([tierId])
  @@map("customers")
}

model LoyaltyAccount {
  id           String               @id @default(uuid())
  customerId   String               @unique @map("customer_id")
  totalPoints  Int                  @default(0) @map("total_points")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")
  customer     Customer             @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@index([customerId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  loyaltyAccountId String                 @map("loyalty_account_id")
  points           Int
  balanceAfter     Int                    @map("balance_after")
  type             LoyaltyTransactionType
  referenceType    String?                @map("reference_type")
  referenceId      String?                @map("reference_id")
  reason           String?
  createdAt        DateTime               @default(now()) @map("created_at")
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id])

  @@index([loyaltyAccountId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@map("loyalty_transactions")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id                    String                 @id @default(uuid())
  name                  String
  barcode               String?                @unique
  scientificName        String?                @map("scientific_name")
  description           String?
  categoryId            String                 @map("category_id")
  purchasePrice         Decimal                @default(0.00) @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice          Decimal                @map("selling_price") @db.Decimal(12, 2)
  taxRate               Decimal                @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  minimumStock          Int                    @default(5) @map("minimum_stock")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")
  batches               Batch[]
  inventoryTransactions InventoryTransaction[]
  category              Category               @relation(fields: [categoryId], references: [id])
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  saleReturnItems       SaleReturnItem[]

  @@index([barcode])
  @@index([name])
  @@index([scientificName])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Batch {
  id                    String                 @id @default(uuid())
  productId             String                 @map("product_id")
  batchNumber           String                 @map("batch_number")
  expiryDate            DateTime               @map("expiry_date") @db.Date
  quantity              Int                    @default(0)
  purchasePrice         Decimal                @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice          Decimal                @map("selling_price") @db.Decimal(12, 2)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")
  product               Product                @relation(fields: [productId], references: [id])
  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  saleReturnItems       SaleReturnItem[]

  @@unique([productId, batchNumber])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([productId])
  @@map("batches")
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  phone     String     @unique
  email     String?
  address   String?
  taxNumber String?    @map("tax_number")
  notes     String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  purchases Purchase[]

  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

model Purchase {
  id              String         @id @default(uuid())
  supplierId      String         @map("supplier_id")
  invoiceNumber   String         @unique @map("invoice_number")
  purchaseDate    DateTime       @default(now()) @map("purchase_date")
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0.00) @db.Decimal(12, 2)
  tax             Decimal        @default(0.00) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount Decimal        @default(0.00) @map("remaining_amount") @db.Decimal(12, 2)
  status          PurchaseStatus @default(PENDING)
  createdById     String         @map("created_by_id")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")
  items           PurchaseItem[]
  createdBy       User           @relation(fields: [createdById], references: [id])
  supplier        Supplier       @relation(fields: [supplierId], references: [id])

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([createdById])
  @@index([purchaseDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String   @map("purchase_id")
  productId  String   @map("product_id")
  batchId    String?  @map("batch_id")
  quantity   Int
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  discount   Decimal  @default(0.00) @db.Decimal(12, 2)
  tax        Decimal  @default(0.00) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  batch      Batch?   @relation(fields: [batchId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@index([batchId])
  @@map("purchase_items")
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  productId     String                   @map("product_id")
  batchId       String?                  @map("batch_id")
  quantity      Int
  type          InventoryTransactionType
  referenceType String?                  @map("reference_type")
  referenceId   String?                  @map("reference_id")
  reason        String?
  createdById   String?                  @map("created_by_id")
  createdAt     DateTime                 @default(now()) @map("created_at")
  batch         Batch?                   @relation(fields: [batchId], references: [id])
  createdBy     User?                    @relation(fields: [createdById], references: [id])
  product       Product                  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([batchId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@index([createdById], map: "inventory_transactions_created_by_id_fkey")
  @@map("inventory_transactions")
}

model Sale {
  id                     String                  @id @default(uuid())
  invoiceNumber          String                  @unique @map("invoice_number")
  customerId             String?                 @map("customer_id")
  userId                 String                  @map("user_id")
  subtotal               Decimal                 @db.Decimal(12, 2)
  discount               Decimal                 @default(0.00) @db.Decimal(12, 2)
  discountReason         String?                 @map("discount_reason")
  insuranceAmount        Decimal                 @default(0.00) @map("insurance_amount") @db.Decimal(12, 2)
  tax                    Decimal                 @default(0.00) @db.Decimal(12, 2)
  total                  Decimal                 @db.Decimal(12, 2)
  paidAmount             Decimal                 @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount        Decimal                 @default(0.00) @map("remaining_amount") @db.Decimal(12, 2)
  status                 SaleStatus              @default(COMPLETED)
  notes                  String?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at")
  commissionTransactions CommissionTransaction[]
  payments               Payment[]
  insurance              SaleInsurance?
  items                  SaleItem[]
  returns                SaleReturn[]
  customer               Customer?               @relation(fields: [customerId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  whatsAppMessages       WhatsAppMessage[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id          String           @id @default(uuid())
  saleId      String           @map("sale_id")
  productId   String           @map("product_id")
  batchId     String?          @map("batch_id")
  quantity    Int
  unitPrice   Decimal          @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal          @default(0.00) @db.Decimal(12, 2)
  tax         Decimal          @default(0.00) @db.Decimal(12, 2)
  total       Decimal          @db.Decimal(12, 2)
  batch       Batch?           @relation(fields: [batchId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@map("sale_items")
}

model Payment {
  id              String        @id @default(uuid())
  saleId          String        @map("sale_id")
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdById     String        @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       User          @relation(fields: [createdById], references: [id])
  sale            Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([paymentMethod])
  @@index([createdById])
  @@index([createdAt])
  @@map("payments")
}

model Discount {
  id              String       @id @default(uuid())
  code            String?      @unique
  name            String
  type            DiscountType
  value           Decimal      @db.Decimal(12, 2)
  minimumPurchase Decimal      @default(0.00) @map("minimum_purchase") @db.Decimal(12, 2)
  startDate       DateTime?    @map("start_date")
  endDate         DateTime?    @map("end_date")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("discounts")
}

model InsuranceProvider {
  id                        String              @id @default(uuid())
  name                      String              @unique
  phone                     String?
  email                     String?
  address                   String?
  defaultCoveragePercentage Decimal             @default(0.00) @map("default_coverage_percentage") @db.Decimal(5, 2)
  notes                     String?
  isActive                  Boolean             @default(true) @map("is_active")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @default(now()) @updatedAt @map("updated_at")
  customerInsurances        CustomerInsurance[]
  saleInsurances            SaleInsurance[]

  @@map("insurance_providers")
}

model CustomerInsurance {
  id                  String            @id @default(uuid())
  customerId          String            @map("customer_id")
  insuranceProviderId String            @map("insurance_provider_id")
  policyNumber        String            @map("policy_number")
  memberNumber        String            @map("member_number")
  coveragePercentage  Decimal           @map("coverage_percentage") @db.Decimal(5, 2)
  maxCoverageLimit    Decimal?          @map("max_coverage_limit") @db.Decimal(12, 2)
  expiryDate          DateTime?         @map("expiry_date") @db.Date
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  insuranceProvider   InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])

  @@unique([customerId, insuranceProviderId, policyNumber])
  @@index([customerId])
  @@index([insuranceProviderId])
  @@index([policyNumber])
  @@map("customer_insurances")
}

model SaleInsurance {
  id                  String            @id @default(uuid())
  saleId              String            @unique @map("sale_id")
  insuranceProviderId String            @map("insurance_provider_id")
  coveredAmount       Decimal           @map("covered_amount") @db.Decimal(12, 2)
  customerAmount      Decimal           @map("customer_amount") @db.Decimal(12, 2)
  coveragePercentage  Decimal           @map("coverage_percentage") @db.Decimal(5, 2)
  claimReference      String?           @map("claim_reference")
  createdAt           DateTime          @default(now()) @map("created_at")
  insuranceProvider   InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  sale                Sale              @relation(fields: [saleId], references: [id])

  @@index([insuranceProviderId])
  @@index([claimReference])
  @@map("sale_insurances")
}

model SaleReturn {
  id            String           @id @default(uuid())
  returnNumber  String           @unique @map("return_number")
  saleId        String           @map("sale_id")
  customerId    String?          @map("customer_id")
  processedById String           @map("processed_by_id")
  reason        String?
  subtotal      Decimal          @db.Decimal(12, 2)
  tax           Decimal          @default(0.00) @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(12, 2)
  createdAt     DateTime         @default(now()) @map("created_at")
  items         SaleReturnItem[]
  customer      Customer?        @relation(fields: [customerId], references: [id])
  processedBy   User             @relation(fields: [processedById], references: [id])
  sale          Sale             @relation(fields: [saleId], references: [id])

  @@index([returnNumber])
  @@index([saleId])
  @@index([customerId])
  @@index([processedById])
  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String     @id @default(uuid())
  saleReturnId String     @map("sale_return_id")
  saleItemId   String     @map("sale_item_id")
  productId    String     @map("product_id")
  batchId      String?    @map("batch_id")
  quantity     Int
  refundAmount Decimal    @map("refund_amount") @db.Decimal(12, 2)
  batch        Batch?     @relation(fields: [batchId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
  @@index([batchId])
  @@map("sale_return_items")
}

model Expense {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(12, 2)
  category      ExpenseCategory
  description   String
  paymentMethod PaymentMethod   @default(CASH) @map("payment_method")
  expenseDate   DateTime        @default(now()) @map("expense_date")
  createdById   String          @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  createdBy     User            @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@index([createdById])
  @@map("expenses")
}

model CommissionRule {
  id            String                  @id @default(uuid())
  name          String
  percentage    Decimal                 @map("percentage") @db.Decimal(5, 2)
  fixedAmount   Decimal?                @map("fixed_amount") @db.Decimal(12, 2)
  isActive      Boolean                 @default(true) @map("is_active")
  effectiveDate DateTime                @default(now()) @map("effective_date")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at")
  transactions  CommissionTransaction[]

  @@map("commission_rules")
}

model CommissionTransaction {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  saleId           String?         @map("sale_id")
  commissionRuleId String?         @map("commission_rule_id")
  salesAmount      Decimal         @map("sales_amount") @db.Decimal(12, 2)
  commissionAmount Decimal         @map("commission_amount") @db.Decimal(12, 2)
  commissionRate   Decimal         @map("commission_rate") @db.Decimal(5, 2)
  createdAt        DateTime        @default(now()) @map("created_at")
  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  sale             Sale?           @relation(fields: [saleId], references: [id])
  user             User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([saleId])
  @@index([createdAt])
  @@index([commissionRuleId], map: "commission_transactions_commission_rule_id_fkey")
  @@map("commission_transactions")
}

model Payroll {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  baseSalary  Decimal       @map("base_salary") @db.Decimal(12, 2)
  commission  Decimal       @default(0.00) @db.Decimal(12, 2)
  bonus       Decimal       @default(0.00) @db.Decimal(12, 2)
  deductions  Decimal       @default(0.00) @db.Decimal(12, 2)
  netSalary   Decimal       @map("net_salary") @db.Decimal(12, 2)
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payrolls")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model WhatsAppMessage {
  id                String         @id @default(uuid())
  customerId        String?        @map("customer_id")
  saleId            String?        @map("sale_id")
  phone             String
  message           String
  status            WhatsAppStatus @default(PENDING)
  providerMessageId String?        @map("provider_message_id")
  errorMessage      String?        @map("error_message")
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  customer          Customer?      @relation(fields: [customerId], references: [id])
  sale              Sale?          @relation(fields: [saleId], references: [id])

  @@index([customerId])
  @@index([saleId])
  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  action    AuditAction
  entity    String
  entityId  String?     @map("entity_id")
  oldData   String?     @map("old_data") @db.LongText
  newData   String?     @map("new_data") @db.LongText
  metadata  String?     @db.LongText
  createdAt DateTime    @default(now()) @map("created_at")
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([key])
  @@map("system_settings")
}

model ConnectionTest {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("connection_test")
}

enum Role {
  PLATFORM_MANAGER
  PHARMACY_MANAGER
  PHARMACIST
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRED
  REVERSAL
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRED
  MANUAL_IN
  MANUAL_OUT
}

enum SaleStatus {
  COMPLETED
  DRAFT
  CANCELLED
  PARTIALLY_RETURNED
  RETURNED
}

enum PaymentMethod {
  CASH
  VISA
  WALLET
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
  PROMOTIONAL
  CUSTOMER_TIER
  MANUAL
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  MAINTENANCE
  SUPPLIES
  SALARY
  OTHER
}

enum PayrollStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  EXPIRY_ALERT
  SALE_COMPLETED
  SYSTEM_ALERT
  GENERAL
}

enum WhatsAppStatus {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  SALE
  PAYMENT
  RETURN
  INVENTORY_ADJUSTMENT
}
