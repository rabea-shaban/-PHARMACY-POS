{
  "name": "pharmacy-pos-frontend",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-entrypoints.js",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan.bold,magenta.bold\" \"vite\" \"wait-on http-get://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dev:electron": "npm run electron:dev",
    "build:electron": "npm run electron:build"
  },
  "build": {
    "appId": "com.alamal.pharmacypos",
    "productName": "Pharmacy POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../pharmacy-pos-backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../pharmacy-pos-backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../pharmacy-pos-backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../pharmacy-pos-backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rabea-shaban",
        "repo": "-PHARMACY-POS"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pharmacy POS"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.66.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^3.10.1",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^19.0.0-beta-e552027-20250112",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  }
}
